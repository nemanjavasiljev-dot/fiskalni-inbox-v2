NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# APR web-service adapter. Use the contracted APR endpoint supplied to your account.
# URL may contain {query}, {pib} or {mb}; otherwise the app appends ?pib= or ?mb=.
APR_API_URL=https://YOUR_CONTRACTED_APR_ENDPOINT/{query}
APR_API_TOKEN=
APR_API_TOKEN_HEADER=Authorization
APR_API_TOKEN_PREFIX=Bearer 

# V4.1 automatic receipt sending. Generate a long random value in Vercel.
CRON_SECRET=replace-with-a-long-random-secret

# Optional: email invitations for accountants
RESEND_API_KEY=
APP_EMAIL_FROM=FiscalBox <noreply@your-domain.rs>

# V4.4 optional SMS invitations (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# V4.6 browser push (generate VAPID keys; keep private key server-side)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
